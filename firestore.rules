rules_version = '2';

// Правила для Calendar Notes.
// Доступ есть только к своим заметкам: users/{uid}/notes/{yyyy-MM-dd}.
// Всё остальное (включая старую коллекцию notes) закрыто: что не разрешено
// явно, то запрещено.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Формат заметки, который пишет приложение:
    // { delta: string, text: string, accent: string, updatedAt: serverTimestamp }
    function isValidNote(noteId) {
      let d = request.resource.data;
      return noteId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['delta', 'text', 'accent', 'updatedAt'])
        && d.delta is string && d.delta.size() <= 800000
        && d.text is string && d.text.size() <= 200000
        && d.accent is string && d.accent.size() <= 16
        && d.updatedAt == request.time;
    }

    match /users/{userId}/notes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidNote(noteId);
    }

    // Формат темы (заметка без даты):
    // { title: string 1..80, delta: string, text: string, order: int,
    //   createdAt: timestamp, updatedAt: timestamp }
    function isValidTopic(d) {
      return d.keys().hasOnly(['title', 'delta', 'text', 'order', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'delta', 'text', 'order', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.title.trim().size() >= 1
        && d.delta is string && d.delta.size() <= 800000
        && d.text is string && d.text.size() <= 200000
        && d.order is int
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{userId}/topics/{topicId} {
      allow read, delete: if isOwner(userId);
      // создание: оба времени — время сервера
      allow create: if isOwner(userId)
        && isValidTopic(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // изменение: createdAt не меняется; updatedAt — время сервера,
      // кроме перестановки, где меняется только order
      allow update: if isOwner(userId)
        && isValidTopic(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.updatedAt == request.time
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order']));
    }
  }
}
