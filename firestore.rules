rules_version = '2';

// Правила для Calendar Notes.
// Доступ есть только к своим заметкам: users/{uid}/notes/{yyyy-MM-dd}.
// Всё остальное (включая старую коллекцию notes) закрыто: что не разрешено
// явно, то запрещено.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Формат заметки, который пишет приложение:
    // { delta: string, text: string, accent: string, updatedAt: serverTimestamp }
    function isValidNote(noteId) {
      let d = request.resource.data;
      return noteId.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.keys().hasOnly(['delta', 'text', 'accent', 'updatedAt'])
        && d.delta is string && d.delta.size() <= 800000
        && d.text is string && d.text.size() <= 200000
        && d.accent is string && d.accent.size() <= 16
        && d.updatedAt == request.time;
    }

    match /users/{userId}/notes/{noteId} {
      allow read, delete: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidNote(noteId);
    }

    // Формат темы (заметка без даты):
    // { title: string 1..80, delta: string, text: string, order: int,
    //   createdAt: timestamp, updatedAt: timestamp }
    function isValidTopic(d) {
      return d.keys().hasOnly(['title', 'delta', 'text', 'order', 'createdAt', 'updatedAt'])
        && d.keys().hasAll(['title', 'delta', 'text', 'order', 'createdAt', 'updatedAt'])
        && d.title is string && d.title.size() >= 1 && d.title.size() <= 80
        && d.title.trim().size() >= 1
        && d.delta is string && d.delta.size() <= 800000
        && d.text is string && d.text.size() <= 200000
        && d.order is int
        && d.createdAt is timestamp
        && d.updatedAt is timestamp;
    }

    match /users/{userId}/topics/{topicId} {
      allow read, delete: if isOwner(userId);
      // создание: оба времени — время сервера
      allow create: if isOwner(userId)
        && isValidTopic(request.resource.data)
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      // изменение: createdAt не меняется; updatedAt — время сервера,
      // кроме перестановки, где меняется только order
      allow update: if isOwner(userId)
        && isValidTopic(request.resource.data)
        && request.resource.data.createdAt == resource.data.createdAt
        && (request.resource.data.updatedAt == request.time
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['order']));
    }

    // Настройки шаблонов дня — один документ users/{uid}/settings/templates:
    // { version: 1, weekdays: {"1".."7": delta}, blocks: {id: delta},
    //   updatedAt: serverTimestamp }. Приложение пишет его целиком (set).
    function okTemplateDelta(m, k) {
      return !(k in m) || (m[k] is string && m[k].size() <= 100000);
    }

    function isValidTemplates(d) {
      return d.keys().hasOnly(['version', 'weekdays', 'blocks', 'updatedAt'])
        && d.keys().hasAll(['version', 'weekdays', 'blocks', 'updatedAt'])
        && d.version == 1
        && d.weekdays is map
        && d.weekdays.keys().hasOnly(['1', '2', '3', '4', '5', '6', '7'])
        && okTemplateDelta(d.weekdays, '1') && okTemplateDelta(d.weekdays, '2')
        && okTemplateDelta(d.weekdays, '3') && okTemplateDelta(d.weekdays, '4')
        && okTemplateDelta(d.weekdays, '5') && okTemplateDelta(d.weekdays, '6')
        && okTemplateDelta(d.weekdays, '7')
        && d.blocks is map
        && d.blocks.keys().hasOnly(['vadimWeek', 'monthlyReport', 'holidayNote'])
        && okTemplateDelta(d.blocks, 'vadimWeek')
        && okTemplateDelta(d.blocks, 'monthlyReport')
        && okTemplateDelta(d.blocks, 'holidayNote')
        && d.updatedAt == request.time;
    }

    // Личный словарь проверки правописания — users/{uid}/settings/dictionary:
    // { words: [строки 1..64 символа, не больше 5000], updatedAt: serverTimestamp }.
    // Приложение пишет set(merge) с arrayUnion / arrayRemove; за одну запись
    // добавляется не больше 20 новых слов — их длину правила и проверяют
    // (перебирать весь список правила не умеют).
    function okWord(l, i) {
      return l.size() <= i || (l[i] is string && l[i].size() >= 1 && l[i].size() <= 64);
    }

    function isValidDictionary(d, old) {
      let added = d.words.removeAll(old);
      return d.keys().hasOnly(['words', 'updatedAt'])
        && d.keys().hasAll(['words', 'updatedAt'])
        && d.words is list
        && d.words.size() <= 5000
        && added.size() <= 20
        && okWord(added, 0) && okWord(added, 1) && okWord(added, 2) && okWord(added, 3)
        && okWord(added, 4) && okWord(added, 5) && okWord(added, 6) && okWord(added, 7)
        && okWord(added, 8) && okWord(added, 9) && okWord(added, 10) && okWord(added, 11)
        && okWord(added, 12) && okWord(added, 13) && okWord(added, 14) && okWord(added, 15)
        && okWord(added, 16) && okWord(added, 17) && okWord(added, 18) && okWord(added, 19)
        && d.updatedAt == request.time;
    }

    match /users/{userId}/settings/{docId} {
      allow read, delete: if isOwner(userId)
        && (docId == 'templates' || docId == 'dictionary');
      allow create: if isOwner(userId)
        && ((docId == 'templates' && isValidTemplates(request.resource.data))
          || (docId == 'dictionary' && isValidDictionary(request.resource.data, [])));
      allow update: if isOwner(userId)
        && ((docId == 'templates' && isValidTemplates(request.resource.data))
          || (docId == 'dictionary'
            && isValidDictionary(request.resource.data, resource.data.words)));
    }
  }
}
